<UserControl x:Class="Memo.Desktop.Views.TaskReader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" KeyDown="OnKeyDown">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="任务全文" FontSize="18" FontWeight="Bold"/>
        </StackPanel>
        <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="BackButton" Content="返回列表" Click="Close" Padding="9,4" Margin="0,0,6,0"/>
        </WrapPanel>
        <TextBox x:Name="FullText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="任务全文" FontSize="{Binding Display.FontSize, FallbackValue=13}"/>
    </DockPanel>
</UserControl>
