<UserControl x:Class="Memo.Desktop.Views.ShortcutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,3,0">
            <TextBlock Text="快捷键" Style="{StaticResource PageTitle}" Margin="0,0,0,16"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox x:Name="EnableShortcuts" Content="启用全局快捷键"
                              IsEnabled="{Binding CanEdit}" Margin="0,0,0,12"/>
                    <ItemsControl x:Name="Entries">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.05*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding Gesture, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="{Binding Title}" MaxLength="28"
                                             IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             MinHeight="32" TextWrapping="Wrap" VerticalContentAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="12" VerticalAlignment="Center"
                                               TextWrapping="Wrap" Margin="9,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="已生效"><Setter Property="Foreground" Value="{DynamicResource Accent}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="被占用或不可用"><Setter Property="Foreground" Value="{DynamicResource Danger}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="组合无效"><Setter Property="Foreground" Value="{DynamicResource Danger}"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel Margin="0,5,0,0" IsEnabled="{Binding CanEdit}">
                        <Button Content="应用快捷键" Click="Apply" Style="{StaticResource Primary}" Margin="0,0,8,0"/>
                        <Button Content="恢复默认快捷键" Click="Reset"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <TextBlock x:Name="Feedback" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,11,0,0" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
