<UserControl x:Class="Memo.Desktop.Views.LayoutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock Text="大小与位置" Style="{StaticResource PageTitle}" Margin="0,0,0,16"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.46*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="0.54*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="待办栏尺寸" Style="{StaticResource CardTitle}" Margin="0,0,0,8"/>
                        <Grid IsEnabled="{Binding CanEdit}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,4,0">
                                <TextBlock Text="宽度"/>
                                <TextBox x:Name="WidthInput" MinHeight="32" MaxLength="3" VerticalContentAlignment="Center"
                                         AutomationProperties.Name="待办栏宽度"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Text="高度"/>
                                <TextBox x:Name="HeightInput" MinHeight="32" MaxLength="3" VerticalContentAlignment="Center"
                                         AutomationProperties.Name="待办栏高度"/>
                            </StackPanel>
                        </Grid>
                        <WrapPanel Margin="0,7,0,0">
                            <Button Content="应用大小" Style="{StaticResource Primary}" HorizontalAlignment="Left" Click="ApplySize"
                                    IsEnabled="{Binding CanEdit}" Margin="0,0,8,0"/>
                            <TextBlock x:Name="AppliedSize" Style="{StaticResource Caption}" FontSize="12" VerticalAlignment="Center"/>
                        </WrapPanel>
                        <Border Height="1" Background="{DynamicResource Edge}" Margin="0,12,0,10"/>
                        <TextBlock Text="桌面位置" Style="{StaticResource CardTitle}" Margin="0,0,0,8"/>
                        <Button Content="恢复默认位置" HorizontalAlignment="Left" Click="ResetPosition" IsEnabled="{Binding CanEdit}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="当前显示器" Style="{StaticResource CardTitle}"/>
                        <TextBlock x:Name="MonitorTitle" Text="工作区预览" Style="{StaticResource Caption}" FontSize="12" Margin="0,8,0,12"/>
                        <Border Background="{DynamicResource PreviewBackground}" BorderBrush="{DynamicResource PreviewBorder}" BorderThickness="1" CornerRadius="7" Padding="5">
                            <Canvas x:Name="Preview" Height="175" ClipToBounds="True" SizeChanged="RefreshPreview"/>
                        </Border>
                        <TextBlock x:Name="Coordinates" Style="{StaticResource Caption}" FontSize="12" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel IsEnabled="{Binding CanEdit}">
                    <TextBlock Text="字号" Style="{StaticResource CardTitle}" Margin="0,0,0,8"/>
                    <WrapPanel>
                        <Button x:Name="FontDown" Content="−" Width="38" Padding="0" Click="DecreaseFont"
                                AutomationProperties.Name="减小字号"/>
                        <TextBlock x:Name="FontValue" Width="42" TextAlignment="Center" VerticalAlignment="Center"/>
                        <Button x:Name="FontUp" Content="+" Width="38" Padding="0" Click="IncreaseFont"
                                AutomationProperties.Name="增大字号"/>
                        <Button Content="应用字号" Style="{StaticResource Primary}" Click="ApplyFont" Margin="8,0,0,0"/>
                    </WrapPanel>
                    <TextBlock x:Name="FontPreview" Text="字号预览 · 待办与便签" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <CheckBox x:Name="AddAtTop" Content="将新增条目按钮移至顶部" IsEnabled="{Binding CanEdit}"
                          IsChecked="{Binding Display.AddAtTop, Mode=OneWay}" Click="SetAddPosition"/>
            </Border>
            <Border x:Name="StatusBanner" Visibility="Collapsed" Margin="0,12,0,0" CornerRadius="7" Padding="11,8">
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
