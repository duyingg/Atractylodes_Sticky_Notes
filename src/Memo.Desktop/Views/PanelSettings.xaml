<UserControl x:Class="Memo.Desktop.Views.PanelSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="便签设置" Style="{StaticResource PageTitle}" Margin="0,0,0,16"/>
        <Border Style="{StaticResource Card}">
            <StackPanel IsEnabled="{Binding CanEdit}">
                <CheckBox x:Name="ShowTasks" Content="待办栏" IsChecked="{Binding Display.ShowTasks, Mode=OneWay}" Margin="0,0,0,10"/>
                <CheckBox x:Name="ShowNote" Content="便签栏" IsChecked="{Binding Display.ShowNote, Mode=OneWay}" Margin="0,0,0,12"/>
                <CheckBox x:Name="NoteLines" Content="为便签添加分行线" IsChecked="{Binding Display.NoteLines, Mode=OneWay}" Margin="0,0,0,12"/>
                <Button Content="应用" Click="Apply" Style="{StaticResource Primary}" HorizontalAlignment="Left"/>
            </StackPanel>
        </Border>
        <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,11,0,0" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>
</UserControl>
