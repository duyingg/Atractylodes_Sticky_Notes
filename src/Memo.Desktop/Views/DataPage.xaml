<UserControl x:Class="Memo.Desktop.Views.DataPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock Text="数据与权限" Style="{StaticResource PageTitle}" Margin="0,0,0,16"/>
            <Border Visibility="{Binding HasWarning, Converter={StaticResource VisibleWhenTrue}}" Background="{DynamicResource DangerWash}"
                    CornerRadius="7" Padding="11,8" Margin="0,0,0,10">
                <DockPanel>
                    <Path Style="{StaticResource Glyph}" Data="{StaticResource WarnIcon}" Stroke="{DynamicResource Danger}"
                          DockPanel.Dock="Left" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding LoadWarning}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="任务编辑权限" Style="{StaticResource CardTitle}" Margin="0,0,0,8"/>
                    <TextBlock Text="恢复数据后才能更改任务编辑权限。" Style="{StaticResource Caption}" Margin="0,0,0,8"
                               Visibility="{Binding HasWarning, Converter={StaticResource VisibleWhenTrue}}"/>
                    <Button Content="{Binding TaskPermissionAction}" IsEnabled="{Binding CanEdit}" Click="ToggleTaskLock"
                            HorizontalAlignment="Left" Style="{StaticResource Primary}"/>
                    <TextBlock x:Name="PermissionStatus" TextWrapping="Wrap" Margin="0,7,0,0" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="数据文件" Style="{StaticResource CardTitle}" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding DataPath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                             AutomationProperties.Name="数据文件路径" Foreground="{DynamicResource Second}"/>
                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="打开存储目录" Click="OpenDirectory" Margin="0,0,0,5"/>
                    </WrapPanel>
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,0">
                        <Hyperlink Click="OpenProperties" Foreground="{DynamicResource Accent}">Windows 文件夹权限</Hyperlink>
                    </TextBlock>
                    <TextBlock x:Name="AccessStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="{Binding BackupLabel}" DockPanel.Dock="Right" FontSize="13" FontWeight="SemiBold" Margin="7,2,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BackupLabel}" Value="不可用"><Setter Property="Foreground" Value="{DynamicResource Danger}"/></DataTrigger>
                                        <DataTrigger Binding="{Binding BackupLabel}" Value="尚未生成"><Setter Property="Foreground" Value="{DynamicResource Muted}"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="上一个有效备份" Style="{StaticResource CardTitle}"/>
                    </DockPanel>
                </StackPanel>
            </Border>
            <Border Visibility="{Binding ShowRestore, Converter={StaticResource VisibleWhenTrue}}"
                    Background="{DynamicResource DangerWash}" CornerRadius="9" Padding="15" Margin="0,0,0,12">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="确认恢复" Click="Restore" Style="{StaticResource Primary}"
                            IsEnabled="{Binding CanRestore}" VerticalAlignment="Center" MinWidth="100" Margin="9,0,0,0"/>
                    <TextBlock Text="从备份恢复数据" Style="{StaticResource CardTitle}" Foreground="{DynamicResource Danger}"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
            <Border x:Name="StatusBanner" Visibility="Collapsed" Margin="0,10,0,0" CornerRadius="7" Padding="11,8">
                <TextBlock x:Name="Status" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
