<UserControl x:Class="Memo.Desktop.Views.TaskForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Memo.Desktop.Views"
             KeyDown="OnKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border>
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                    <Setter Property="Padding" Value="20"/>

                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Compact, RelativeSource={RelativeSource AncestorType=views:TaskForm}}" Value="True">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>

                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="任务内容" FontWeight="SemiBold" Foreground="{DynamicResource Second}" Margin="0,0,0,6"/>
                <TextBox x:Name="Input" Grid.Row="1" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" MaxLength="240" MinHeight="55" MaxHeight="190"
                         AutomationProperties.Name="任务内容" TextChanged="UpdateCount" FontSize="{Binding Display.FontSize, FallbackValue=13}"/>
                <TextBlock x:Name="Count" Grid.Row="2" Text="0 / 240" HorizontalAlignment="Right"
                           Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,4,0,0"/>
                <Grid Grid.Row="3" Margin="0,6,0,0">
                    <Border x:Name="ErrorBanner" Visibility="Collapsed" CornerRadius="6" Padding="8,5"
                            Background="{DynamicResource DangerWash}">
                        <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{DynamicResource Danger}"
                                   FontSize="12" AutomationProperties.LiveSetting="Polite"/>
                    </Border>
                </Grid>
            </Grid>
        </Border>
        </ScrollViewer>
        <Border Grid.Row="1" BorderBrush="{DynamicResource Edge}" BorderThickness="0,1,0,0"
                Margin="0,8,0,0" Padding="0,8,0,0">
            <WrapPanel HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="取消编辑" Click="Cancel" MinWidth="62" Margin="0,0,9,0"/>
                <Button x:Name="SaveButton" Content="保存任务" Click="Save" MinWidth="79" Style="{StaticResource Primary}"/>
            </WrapPanel>
        </Border>
    </Grid>
</UserControl>
