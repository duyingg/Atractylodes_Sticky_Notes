<UserControl x:Class="Memo.Desktop.Views.TaskList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Memo.Desktop.Views">
    <DockPanel>
        <TextBlock x:Name="ErrorText" DockPanel.Dock="Bottom" Foreground="{DynamicResource Danger}"
                   TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        <Grid>
            <ListBox x:Name="Rows" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="True" VirtualizingPanel.ScrollUnit="Pixel"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     AutomationProperties.Name="任务列表">
                <ListBox.Resources>
                    <Style x:Key="PageScroll" TargetType="RepeatButton">
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style TargetType="ScrollBar">
                        <Setter Property="Width" Value="7"/>
                        <Setter Property="Background" Value="{DynamicResource Edge}"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid Background="Transparent" Margin="2,0,0,3">
                                        <Border Background="{TemplateBinding Background}" Width="5" CornerRadius="3" HorizontalAlignment="Right"/>
                                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Style="{StaticResource PageScroll}" Command="ScrollBar.PageUpCommand"/>
                                            </Track.DecreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb MinHeight="12">
                                                    <Thumb.Template>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Grid Background="Transparent">
                                                                <Border Background="{DynamicResource ScrollThumb}" Width="5" HorizontalAlignment="Right" CornerRadius="3"/>
                                                            </Grid>
                                                        </ControlTemplate>
                                                    </Thumb.Template>
                                                </Thumb>
                                            </Track.Thumb>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Style="{StaticResource PageScroll}" Command="ScrollBar.PageDownCommand"/>
                                            </Track.IncreaseRepeatButton>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.Resources>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="AutomationProperties.Name" Value="{Binding Task.Text}"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,4">
                            <Border x:Name="TaskSurface" Background="{DynamicResource Light}" CornerRadius="6">
                                <Grid Margin="8,5,5,5"
                                      Height="{Binding DataContext.TaskPreviewHeight, RelativeSource={RelativeSource AncestorType=views:TaskList}, FallbackValue=39}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="Check" Width="15" Height="15" Margin="0,0,6,0"
                                              VerticalAlignment="Center" Click="Toggle"
                                              IsChecked="{Binding Task.IsCompleted, Mode=OneWay}"
                                              IsEnabled="{Binding DataContext.CanEditTasks, RelativeSource={RelativeSource AncestorType=views:TaskList}}"
                                              AutomationProperties.Name="标为完成" AutomationProperties.HelpText="{Binding Task.Text}">
                                        <CheckBox.Template>
                                            <ControlTemplate TargetType="CheckBox">
                                                <Border x:Name="Box" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource CheckEdge}" BorderThickness="1">
                                                    <Path x:Name="Tick" Style="{StaticResource Glyph}" Data="{StaticResource CheckIcon}"
                                                          Stroke="{DynamicResource Accent}" Width="10" Height="10"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                        <Setter TargetName="Box" Property="BorderThickness" Value="2"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="Box" Property="Opacity" Value="0.65"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </CheckBox.Template>
                                    </CheckBox>
                                    <Button x:Name="ReadAction" Grid.Column="1" Grid.RowSpan="2" Click="OpenTask" Cursor="Hand"
                                            Margin="0,0,7,0" Padding="0" MinHeight="0"
                                            AutomationProperties.Name="{Binding Task.Text}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent">
                                                    <ContentPresenter HorizontalAlignment="Stretch"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <!-- Extra space keeps the second line visible after DPI layout rounding. -->
                                        <TextBlock x:Name="TaskText" Text="{Binding Task.Text}" ClipToBounds="True"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                   LineHeight="{Binding DataContext.TaskLineHeight, RelativeSource={RelativeSource AncestorType=views:TaskList}, FallbackValue=19}"
                                                   LineStackingStrategy="BlockLineHeight" FontWeight="Normal"
                                                   FontSize="{Binding DataContext.Display.FontSize, RelativeSource={RelativeSource AncestorType=views:TaskList}, FallbackValue=13}"/>
                                    </Button>
                                    <Button x:Name="DeleteAction" Grid.Row="1" Grid.Column="2" Style="{StaticResource Quiet}"
                                            Foreground="{DynamicResource Second}" FontSize="12" Padding="0" MinHeight="0"
                                            Click="AskDelete" IsEnabled="{Binding DataContext.CanEditTasks, RelativeSource={RelativeSource AncestorType=views:TaskList}}"
                                            Content="删除" AutomationProperties.Name="删除任务" AutomationProperties.HelpText="{Binding Task.Text}"/>
                                    <Thumb x:Name="Grip" Grid.Column="2" Width="40"
                                           Cursor="SizeNS" Focusable="False"
                                           AutomationProperties.Name="拖动排序" DragStarted="StartDrag"
                                           DragDelta="DragTask" DragCompleted="FinishDrag"
                                           IsEnabled="{Binding DataContext.CanEditTasks, RelativeSource={RelativeSource AncestorType=views:TaskList}}">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="Transparent" CornerRadius="5">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <Path Style="{StaticResource Glyph}" Data="{StaticResource GripIcon}"
                                                              Stroke="{DynamicResource Second}" StrokeThickness="2" Width="8" Height="14"/>
                                                        <TextBlock Text="排序" Foreground="{DynamicResource Second}" FontSize="11" Margin="2,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Grid>
                            </Border>
                            <Border x:Name="DropLine" Height="2" VerticalAlignment="Top" CornerRadius="1"
                                    Background="{DynamicResource Accent}" Visibility="Collapsed" IsHitTestVisible="False"/>
                            <Border x:Name="Confirmation" Padding="11,9" Background="{DynamicResource DangerWash}" CornerRadius="8" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="删除这项任务？" Foreground="{DynamicResource Danger}" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="ConfirmationTaskText" Text="{Binding Task.Text}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                               LineHeight="18" LineStackingStrategy="BlockLineHeight" MaxHeight="36" ToolTip="{Binding Task.Text}"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,7,0,0">
                                        <Button Content="取消删除" MinHeight="28" Padding="8,3" Margin="0,0,8,0" Click="CancelDelete"/>
                                        <Button Content="确认删除" Style="{StaticResource DangerButton}" MinHeight="28" Padding="8,3"
                                                IsEnabled="{Binding DataContext.CanEditTasks, RelativeSource={RelativeSource AncestorType=views:TaskList}}"
                                                AutomationProperties.Name="确认删除任务" Click="ConfirmDelete"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                                <Setter TargetName="TaskSurface" Property="Background" Value="{DynamicResource Wash}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DropBefore}" Value="True">
                                <Setter TargetName="DropLine" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DropAfter}" Value="True">
                                <Setter TargetName="DropLine" Property="VerticalAlignment" Value="Bottom"/>
                                <Setter TargetName="DropLine" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Highlighted}" Value="True">
                                <Setter TargetName="TaskSurface" Property="Background" Value="{DynamicResource Wash}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Task.IsCompleted}" Value="True">
                                <Setter TargetName="Check" Property="AutomationProperties.Name" Value="恢复为待办"/>
                                <Setter TargetName="TaskText" Property="TextDecorations" Value="Strikethrough"/>
                                <Setter TargetName="ConfirmationTaskText" Property="TextDecorations" Value="Strikethrough"/>
                                <Setter TargetName="TaskText" Property="Foreground" Value="{DynamicResource Muted}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Confirming}" Value="True">
                                <Setter TargetName="Confirmation" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="TaskSurface" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Compact, RelativeSource={RelativeSource AncestorType=views:TaskList}}" Value="True">
                                <Setter TargetName="DeleteAction" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyText" Text="当前筛选下没有任务。" Visibility="Collapsed" Margin="13,14"
                       Foreground="{DynamicResource Muted}" IsHitTestVisible="False"/>
        </Grid>
    </DockPanel>
</UserControl>
