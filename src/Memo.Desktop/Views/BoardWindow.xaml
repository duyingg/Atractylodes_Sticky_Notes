<Window x:Class="Memo.Desktop.Views.BoardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Memo.Desktop.Views"
        Title="白术便签 · 待办栏" Width="320" Height="320" Style="{StaticResource {x:Type Window}}"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="False"
        Background="{DynamicResource Paper}" Focusable="False" PreviewGotKeyboardFocus="PreventFocus">
    <Window.Resources>
        <Style x:Key="BoardResizeHandle" TargetType="Thumb">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsEnabled" Value="{Binding CanEdit}"/>
            <Setter Property="AutomationProperties.Name" Value="拖动调整便签大小"/>
            <EventSetter Event="DragStarted" Handler="StartResize"/>
            <EventSetter Event="DragDelta" Handler="ResizeBoard"/>
            <EventSetter Event="DragCompleted" Handler="FinishResize"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
    <Border Background="{DynamicResource Paper}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" CornerRadius="12" Padding="14,10,14,10">
        <Grid>
            <DockPanel x:Name="ListPage">
                <Thumb DockPanel.Dock="Top" Height="10" Background="Transparent" Cursor="SizeAll" Focusable="False"
                       AutomationProperties.Name="移动待办栏"
                       DragStarted="StartMove" DragDelta="MoveBoard" DragCompleted="FinishMove">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}"/></ControlTemplate>
                    </Thumb.Template>
                </Thumb>
                <Border>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="DockPanel.Dock" Value="Bottom"/>
                            <Setter Property="Padding" Value="0,5,0,0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Display.AddAtTop}" Value="True">
                                    <Setter Property="DockPanel.Dock" Value="Top"/>
                                    <Setter Property="Padding" Value="0,0,0,5"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="权限设置" Visibility="{Binding TaskReadOnly, Converter={StaticResource VisibleWhenTrue}}"
                                MinHeight="35" Padding="7,4" Focusable="False" Click="OpenData"/>
                        <Button DockPanel.Dock="Right" MinHeight="35" Padding="9,5" Style="{StaticResource Primary}"
                                Focusable="False" IsEnabled="{Binding CanEditTasks}" AutomationProperties.Name="新增条目" Click="Add">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Glyph}" Data="{StaticResource PlusIcon}" Stroke="{DynamicResource OnAccent}" Width="14" Height="14" Margin="0,0,4,0"/>
                                <TextBlock Text="新增" Foreground="{DynamicResource OnAccent}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,6,0">
                            <TextBlock x:Name="TaskCount" TextWrapping="Wrap" Foreground="{DynamicResource Second}" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUnavailable}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="待办 {0}  ·  已完成 {1}">
                                        <Binding Path="Remaining"/>
                                        <Binding Path="Completed"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock x:Name="Notice" TextWrapping="Wrap" Foreground="{DynamicResource Danger}" FontSize="12"
                                       AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Grid>
                    <views:TaskList x:Name="Tasks" Compact="True" KeyboardNavigation.TabNavigation="None"/>
                    <TextBlock Text="本地数据暂不可读" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding IsUnavailable, Converter={StaticResource VisibleWhenTrue}}"/>
                </Grid>
            </DockPanel>
            <views:TaskForm x:Name="Form" Compact="True" Visibility="Collapsed"/>
            <views:TaskReader x:Name="Reader" Visibility="Collapsed"/>
        </Grid>
    </Border>
    <Thumb Style="{StaticResource BoardResizeHandle}" Tag="Left" Cursor="SizeWE"
           HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="6" Margin="0,13,0,13"/>
    <Thumb Style="{StaticResource BoardResizeHandle}" Tag="Top" Cursor="SizeNS"
           HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="6" Margin="13,0,13,0"/>
    <Thumb Style="{StaticResource BoardResizeHandle}" Tag="Right" Cursor="SizeWE"
           HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="6" Margin="0,13,0,13"/>
    <Thumb Style="{StaticResource BoardResizeHandle}" Tag="Bottom" Cursor="SizeNS"
           HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="6" Margin="13,0,13,0"/>
    <Thumb Style="{StaticResource BoardResizeHandle}" Tag="Left,Top" Cursor="SizeNWSE"
           HorizontalAlignment="Left" VerticalAlignment="Top" Width="13" Height="13"/>
    <Thumb Style="{StaticResource BoardResizeHandle}" Tag="Right,Top" Cursor="SizeNESW"
           HorizontalAlignment="Right" VerticalAlignment="Top" Width="13" Height="13"/>
    <Thumb Style="{StaticResource BoardResizeHandle}" Tag="Left,Bottom" Cursor="SizeNESW"
           HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="13" Height="13"/>
    <Thumb Style="{StaticResource BoardResizeHandle}" Tag="Right,Bottom" Cursor="SizeNWSE"
           HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="13" Height="13"/>
    </Grid>
</Window>
